local WindUI = loadstring(game:HttpGet(
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
))()

local Window = WindUI:CreateWindow({
    Title = "M4pr Hub",

    Size = UDim2.fromOffset(580, 460),

    Transparent = false,
    Theme = "Dark",
    Resizable = true,

    SideBarWidth = 200,
    HideSearchBar = false,
    ScrollBarEnabled = true,
})

--// Load the 4 tab scripts FIRST
local urls = {
    "https://pastefy.app/wKf0yGlA/raw", -- Chance
    "https://pastefy.app/Lo9r8NYz/raw", -- Guest1337
    "https://pastefy.app/PP5vNKFk/raw", -- ESP
    "https://pastefy.app/tfsMD3ff/raw", -- Player
}

local source = {}
local done = 0

-- Download simultaneously
for i, url in ipairs(urls) do
    task.spawn(function()
        local ok, result = pcall(function()
            return game:HttpGet(url)
        end)

        if ok then
            source[i] = result
        end

        done += 1
    end)
end

while done < #urls do
    task.wait()
end

for i = 1, #urls do
    if source[i] then
        local fn = loadstring(source[i])

        if fn then
            pcall(fn)
        end
    end
end

